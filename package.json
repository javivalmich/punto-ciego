{
  "name": "punto-ciego",
  "version": "1.0.0",
  "private": true,
  "description": "Punto Ciego, de Punto Studio. La web se sirve tal cual desde la raíz (GitHub Pages); package.json solo existe para la app iOS con Capacitor.",
  "scripts": {
    "web": "node scripts/preparar-www.mjs",
    "cap:sync": "node scripts/preparar-www.mjs && cap sync ios",
    "cap:abrir": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "8.0.2",
    "@capgo/capacitor-social-login": "^8.5.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  }
}
